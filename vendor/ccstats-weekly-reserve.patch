+                sample_event(0, "gpt-5", 0, 0, Some(0.0)),
+                sample_event(1, "gpt-5", 90_000_000, 90_000_000, Some(10.0)),
+                sample_event(2, "gpt-5.4", 290_000_000, 200_000_000, Some(20.0)),
+            ]
+            .join("\n"),
