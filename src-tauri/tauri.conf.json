{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaBar",
  "version": "0.5.0",
  "identifier": "com.majiayu.quotabar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuotaBar · Tray",
        "width": 340,
        "minWidth": 280,
        "height": 200,
        "minHeight": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "backgroundThrottling": "disabled",
        "visible": false,
        "skipTaskbar": true,
        "label": "main",
        "url": "index.html?window=tray"
      },
      {
        "title": "QuotaBar",
        "width": 1280,
        "minWidth": 760,
        "height": 850,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "backgroundThrottling": "disabled",
        "visible": true,
        "skipTaskbar": false,
        "label": "analysis",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
